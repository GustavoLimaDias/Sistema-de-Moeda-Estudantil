@startuml classes
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
  BackgroundColor #EEF3FB
  BorderColor #2F5597
  ArrowColor #404040
  HeaderBackgroundColor #D6E2F5
}
hide circle
hide empty members

abstract class Usuario {
  - id : Long
  - nome : String
  - email : String
  - login : String
  - senhaHash : String
  + autenticar(login : String, senha : String) : boolean
  + alterarSenha(atual : String, nova : String) : void
}

class Aluno {
  - cpf : String
  - rg : String
  - curso : String
  - saldo : int
  + receberMoedas(valor : int) : void
  + resgatarVantagem(v : Vantagem) : ResgateVantagem
  + consultarExtrato() : List<Transacao>
}

class Professor {
  - cpf : String
  - departamento : String
  - saldo : int
  + enviarMoedas(aluno : Aluno, valor : int, motivo : String) : TransferenciaMoeda
  + creditarSemestre(valor : int) : void
  + consultarExtrato() : List<Transacao>
}

class EmpresaParceira {
  - cnpj : String
  - descricao : String
  + cadastrarVantagem(v : Vantagem) : void
  + removerVantagem(v : Vantagem) : void
}

class Administrador {
  + cadastrarInstituicao(i : InstituicaoEnsino) : void
  + importarProfessores(i : InstituicaoEnsino, lista : List<Professor>) : void
}

class Endereco {
  - logradouro : String
  - numero : String
  - complemento : String
  - bairro : String
  - cidade : String
  - uf : String
  - cep : String
}

class InstituicaoEnsino {
  - id : Long
  - nome : String
  - cnpj : String
}

class Vantagem {
  - id : Long
  - nome : String
  - descricao : String
  - fotoUrl : String
  - custo : int
  - ativa : boolean
}

abstract class Transacao {
  - id : Long
  - dataHora : LocalDateTime
  - valor : int
  + getDescricao() : String
}

class TransferenciaMoeda {
  - motivo : String
}

class ResgateVantagem {
  - codigoCupom : String
  - status : StatusResgate
  + gerarCodigo() : String
}

class CreditoSemestral {
  - semestre : String
}

enum StatusResgate {
  PENDENTE
  CONFERIDO
  CANCELADO
}

Usuario <|-down- Administrador
Usuario <|-down- EmpresaParceira
Usuario <|-down- Aluno
Usuario <|-down- Professor

Administrador -[hidden]right- EmpresaParceira
EmpresaParceira -[hidden]right- Endereco
Aluno "1" *-left- "1" Endereco
Aluno "0..*" -right-> "1" InstituicaoEnsino : estuda em
Professor "0..*" -left-> "1" InstituicaoEnsino : vinculado a
EmpresaParceira "1" *-down- "0..*" Vantagem : oferece

ResgateVantagem "0..*" -left-> "1" Vantagem
ResgateVantagem "0..*" -up-> "1" Aluno : resgatado por
TransferenciaMoeda "0..*" -up-> "1" Aluno : destinatário
TransferenciaMoeda "0..*" -up-> "1" Professor : remetente
CreditoSemestral "0..*" -up-> "1" Professor : creditado a

TransferenciaMoeda -down-|> Transacao
ResgateVantagem -down-|> Transacao
CreditoSemestral -down-|> Transacao
StatusResgate -[hidden]right- Transacao
Vantagem -[hidden]down- StatusResgate
@enduml
