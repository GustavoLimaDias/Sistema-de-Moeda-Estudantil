@startuml componentes
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam componentStyle uml2
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 55
skinparam ArrowColor #404040
skinparam component {
  BorderColor #2F5597
  BackgroundColor #EEF3FB
  BackgroundColor<<View>> #E8F5E9
  BorderColor<<View>> #2E7D32
  BackgroundColor<<Controller>> #FFF4E0
  BorderColor<<Controller>> #B26A00
  BackgroundColor<<Segurança>> #FDECEA
  BorderColor<<Segurança>> #C0392B
  BackgroundColor<<Repository>> #F3E8FA
  BorderColor<<Repository>> #6A1B9A
  BackgroundColor<<Infra>> #F2F2F2
  BorderColor<<Infra>> #555555
}
skinparam database {
  BackgroundColor #F3E8FA
  BorderColor #6A1B9A
}
skinparam cloud {
  BackgroundColor #F2F2F2
  BorderColor #555555
}

component "Front-end Web (HTML/CSS/JS)\nlogin · cadastro · aluno · professor · empresa · admin\napi.js → fetch API REST + token Bearer" as VIEW <<View>>
component "AutenticacaoInterceptor\nTokenService\n(@Publico / @RequerPerfil)" as SEC <<Segurança>>

component "AuthController\n/api/auth\n(+ PUT /senha)" as CAuth <<Controller>>
component "AlunoController\n/api/alunos\n(+ cancelar resgate)" as CAluno <<Controller>>
component "EmpresaParceiraController\n/api/empresas\n(+ cancelar resgate)" as CEmp <<Controller>>
component "ProfessorController\n/api/professores\n(+ PUT/DELETE /{id})" as CProf <<Controller>>
component "VantagemController\n/api/vantagens" as CVant <<Controller>>
component "InstituicaoController\nAdminController\n(+ DELETE instituição)" as CAdm <<Controller>>

component "AutenticacaoService" as SAuth <<Service>>
component "AlunoService\nEmpresaParceiraService\nUsuarioService" as SCad <<Service>>
component "TransacaoService\n(envio, resgate, extrato, cupom,\ncancelamento com estorno)" as STrans <<Service>>
component "ProfessorService\n(cadastrar, importar,\neditar, excluir)" as SProf <<Service>>
component "VantagemService" as SVant <<Service>>
component "InstituicaoService\nCreditoSemestralService" as SAdm <<Service>>
component "Agendador Spring\n@Scheduled (1º/jan e 1º/jul)" as Sched <<Infra>>
component "NotificacaoService\n(@TransactionalEventListener)" as SNot <<Service>>

component "UsuarioRepository\nAlunoRepository\nEmpresaParceiraRepository" as RUsu <<Repository>>
component "TransferenciaMoedaRepository\nResgateVantagemRepository\nCreditoSemestralRepository" as RTrans <<Repository>>
component "ProfessorRepository" as RProf <<Repository>>
component "VantagemRepository" as RVant <<Repository>>
component "InstituicaoEnsinoRepository" as RInst <<Repository>>
component "NotificacaoEmailRepository" as RNot <<Repository>>

database "H2 / PostgreSQL\nJPA · Hibernate (ORM)" as DB
cloud "Servidor SMTP\n(opcional)" as SMTP

VIEW -down-> SEC : HTTP/JSON
SEC -down-> CAuth
SEC -down-> CAluno
SEC -down-> CEmp
SEC -down-> CProf
SEC -down-> CVant
SEC -down-> CAdm
CAuth -[hidden]right- CAluno
CAluno -[hidden]right- CEmp
CEmp -[hidden]right- CProf
CProf -[hidden]right- CVant
CVant -[hidden]right- CAdm

CAuth -down-> SAuth
CAluno -down-> SCad
CAluno -down-> STrans
CEmp -down-> STrans
CProf -down-> STrans
CProf -down-> SProf
CVant -down-> SVant
CAdm -down-> SAdm
Sched -left-> SAdm
SAuth -[hidden]right- SCad
SCad -[hidden]right- STrans
STrans -[hidden]right- SProf
SProf -[hidden]right- SVant
SVant -[hidden]right- SAdm

STrans -down-> SNot : evento
STrans -down--> RTrans
SNot -down-> RNot
SNot -down-> SMTP
SAuth -down--> RUsu
SCad -down--> RUsu
SProf -down-> RProf
SVant -down-> RVant
SAdm -down-> RInst
RUsu -[hidden]right- SMTP
SNot -[hidden]right- RProf
RProf -[hidden]right- RVant
RVant -[hidden]right- RInst

RUsu -down-> DB
RTrans -down-> DB
RNot -down-> DB
SMTP -[hidden]right- RNot
RNot -[hidden]right- RTrans
RProf -down-> DB
RVant -down-> DB
RInst -down-> DB

note right of RInst
  <b>v4 (Release 2 – Lab04S01)</b>
  • novas rotas nos controllers existentes;
  • ProfessorService (editar/excluir) e VantagemController
    aparecem separados para deixar as dependências explícitas;
  • TransacaoService cancela resgates com estorno e publica
    o evento que gera os emails de cancelamento.
end note

legend right
  |= Cor |= Camada |
  |<#E8F5E9>      | View |
  |<#FDECEA>      | Segurança (autenticação/autorização) |
  |<#FFF4E0>      | Controller |
  |<#EEF3FB>      | Model – Serviços (regras de negócio) |
  |<#F3E8FA>      | Model – Persistência (Repository/DAO + ORM) |
  |<#F2F2F2>      | Infraestrutura / externos |
endlegend
@enduml
