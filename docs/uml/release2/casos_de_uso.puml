@startuml casos_de_uso
' v2 (Release 2 / Lab04S01): UC14 ampliado, UC15 inclui alterar senha, novos UC16, UC17 e UC18
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF3FB
  BorderColor #2F5597
  ArrowColor #404040
}
skinparam usecase<<novo>> {
  BackgroundColor #FFF4E0
  BorderColor #B26A00
}
skinparam rectangle {
  BorderColor #2F5597
  BackgroundColor #FFFFFF
}
skinparam ArrowColor #404040
skinparam ActorBorderColor #2F5597

actor "Professor" as P
actor "Aluno" as A
actor "Empresa Parceira" as E
actor "Administrador" as ADM
actor "Usuário" as U
actor "Tempo\n(início de semestre)" as T
actor "Serviço de Email" as MAIL

rectangle "Sistema de Moeda Estudantil" {
  usecase "UC05 Enviar moedas" as UC05
  usecase "UC06 Notificar aluno\npor email" as UC06
  usecase "UC04 Consultar extrato" as UC04
  usecase "UC02 Cadastrar-se\ncomo aluno" as UC02
  usecase "UC07 Consultar vantagens" as UC07
  usecase "UC08 Resgatar vantagem" as UC08
  usecase "UC09 Gerar código\nde cupom" as UC09
  usecase "UC10 Enviar emails de\ncupom (aluno e parceiro)" as UC10
  usecase "UC17 Cancelar resgate\n(estorno)" as UC17 <<novo>>
  usecase "UC18 Notificar\ncancelamento por email" as UC18 <<novo>>
  usecase "UC16 Conferir cupom" as UC16 <<novo>>
  usecase "UC03 Cadastrar-se como\nempresa parceira" as UC03
  usecase "UC11 Gerenciar vantagens" as UC11
  usecase "UC13 Gerenciar\ninstituições" as UC13
  usecase "UC14 Gerenciar professores\n(cadastrar, importar,\neditar, excluir)" as UC14 <<novo>>
  usecase "UC01 Realizar login" as UC01
  usecase "UC15 Gerenciar perfil\ne alterar senha" as UC15 <<novo>>
  usecase "UC12 Creditar moedas\nsemestrais" as UC12
}

A -|> U
P -|> U
E -|> U
ADM -|> U

P --> UC05
P --> UC04
A --> UC04
A --> UC02
A --> UC07
A --> UC08
A --> UC17
E --> UC17
E --> UC16
E --> UC03
E --> UC11
ADM --> UC13
ADM --> UC14
U --> UC01
U --> UC15
T --> UC12

UC05 ..> UC06 : <<include>>
UC08 ..> UC09 : <<include>>
UC08 ..> UC10 : <<include>>
UC17 ..> UC18 : <<include>>

UC06 --> MAIL
UC10 --> MAIL
UC18 --> MAIL

UC05 -[hidden]right- UC04
UC04 -[hidden]right- UC02
UC02 -[hidden]right- UC07
UC07 -[hidden]right- UC08
UC08 -[hidden]right- UC17
UC17 -[hidden]right- UC16
UC16 -[hidden]right- UC03
UC03 -[hidden]right- UC11
UC11 -[hidden]right- UC13
UC13 -[hidden]right- UC14
UC14 -[hidden]right- UC01
UC01 -[hidden]right- UC15
UC15 -[hidden]right- UC12
P -[hidden]right- A
A -[hidden]right- E
E -[hidden]right- ADM
ADM -[hidden]right- U
U -[hidden]right- T

legend right
  <back:#FFF4E0>   </back> novo ou ampliado na Release 2
endlegend
@enduml
